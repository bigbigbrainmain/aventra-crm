# Copy this to .env and fill in your values
# Get these from your credentials.json service account file

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1EclGQA4RZMrAKcYHfYclZnA_NzuzgKmPCqhq0cYA3NE

# Google Cloud API key — needed for Lead Generation (Places API + PageSpeed Insights)
# Enable "Places API" and "PageSpeed Insights API" in Google Cloud Console
GOOGLE_API_KEY=your-google-api-key-here

# Shared secret between GitHub Actions and this CRM (generate any strong random string)
PROPOSAL_WEBHOOK_SECRET=your-webhook-secret-here

# Fine-grained GitHub PAT with read-only Contents access to aventra-proposals
# Used to list proposal folders in the lead detail combobox
GH_TOKEN=your-fine-grained-pat-here
